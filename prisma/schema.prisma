// AgencyOS — Prisma schema (SQLite adapter)
// Mirrors the AgencyOS build contract's data model.
// SQLite does not support native enums or JSONB; we use String + Json types
// and enforce invariants at the application layer (lib/permissions, lib/audit, lib/validators).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & tenancy
// ---------------------------------------------------------------------------

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  emailNormalized String   @unique
  passwordHash    String?
  displayName     String?
  avatarPath      String?
  locale          String   @default("en")
  timezone        String   @default("UTC")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  lastSignInAt    DateTime?

  memberships     WorkspaceMembership[]
  sessions        Session[]
  timeEntries     TimeEntry[]
  auditEvents     AuditEvent[]
  notifications   Notification[]
  activityEvents  ActivityEvent[]
  activities      Activity[]
  ownedWorkspaces Workspace[]        @relation("WorkspaceOwner")
  ownedLeads      Lead[]
  ownedDeals      Deal[]
  ownedCompanies  Company[]
  ownedContacts   Contact[]
  ownedClients    Client[]
  ownedProjects   Project[]
  ownedTasks      Task[]             @relation("TaskOwner")
  assignedTasks   Task[]             @relation("TaskAssignee")
  ownedCampaigns  Campaign[]         @relation("CampaignOwner")
  ownedDeliverables Deliverable[]    @relation("DeliverableOwner")
  approvalsRequested ApprovalRequest[]
  approvalsDecided   ApprovalStep[]
  approvalEvents      ApprovalEvent[] @relation("ApprovalEventActor")
  invitationsSent     Invitation[]
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  ipHash       String?
  userAgentSummary String?

  @@index([userId])
}

model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  timezone      String   @default("UTC")
  currency      String   @default("USD")
  locale        String   @default("en")
  logoPath      String?
  settingsJson  Json?
  ownerId       String
  owner         User     @relation("WorkspaceOwner", fields: [ownerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships   WorkspaceMembership[]
  roles         Role[]
  teams         Team[]
  invitations   Invitation[]
  featureFlags  FeatureFlag[]
  preferences   WorkspacePreference[]
  auditEvents   AuditEvent[]
  companies     Company[]
  contacts      Contact[]
  leads         Lead[]
  pipelines     Pipeline[]
  deals         Deal[]
  activities    Activity[]
  tags          Tag[]
  notes         Note[]
  clients       Client[]
  serviceCatalog Service[]
  clientRequests ClientRequest[]
  projectTemplates ProjectTemplate[]
  projects      Project[]
  projectStatuses ProjectStatus[]
  taskStatuses  TaskStatus[]
  campaigns     Campaign[]
  deliverables  Deliverable[]
  contentItems  ContentItem[]
  comments      Comment[]
  activityEvents ActivityEvent[]
  notifications Notification[]
  files         FileRecord[]
  approvalRequests ApprovalRequest[]
  timeEntries   TimeEntry[]
  timesheets    Timesheet[]
  capacityAllocations CapacityAllocation[]
  rateCards     RateCard[]
  expenses      Expense[]
  estimates     Estimate[]
  invoices      Invoice[]
  customFieldDefinitions CustomFieldDefinition[]
  customFieldValues       CustomFieldValue[]
  savedViews   SavedView[]
  dashboards    Dashboard[]
  reportDefinitions ReportDefinition[]
  automations   Automation[]
  webhookEndpoints WebhookEndpoint[]
  outboxEvents   OutboxEvent[]
  integrationConnections IntegrationConnection[]
  importJobs    ImportJob[]
  exportJobs    ExportJob[]
  clientPortals ClientPortal[]
  knowledgePages KnowledgePage[]
  tasks         Task[]
}

model WorkspaceMembership {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       String   @default("active") // active | suspended | removed
  title        String?
  joinedAt     DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  roles        MembershipRole[]
  teamMemberships TeamMembership[]
  projectMemberships ProjectMember[]

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Role {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  permissions  RolePermission[]
  memberships  MembershipRole[]
  invitationRoles InvitationRole[]

  @@unique([workspaceId, name])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  description String?

  roles       RolePermission[]
}

model RolePermission {
  roleId      String
  role        Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission  Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model MembershipRole {
  membershipId String
  membership   WorkspaceMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role                @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([membershipId, roleId])
}

model Team {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  TeamMembership[]
  invitationTeams InvitationTeam[]

  @@unique([workspaceId, name])
}

model TeamMembership {
  teamId       String
  team         Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  membershipId String
  membership   WorkspaceMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([teamId, membershipId])
}

model Invitation {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  emailNormalized String
  tokenHash       String   @unique
  expiresAt       DateTime
  acceptedAt      DateTime?
  revokedAt       DateTime?
  invitedById     String
  invitedBy       User     @relation(fields: [invitedById], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  roles           InvitationRole[]
  teams           InvitationTeam[]

  @@index([workspaceId, emailNormalized])
}

model InvitationRole {
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([invitationId, roleId])
}

model InvitationTeam {
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  teamId       String
  team         Team       @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([invitationId, teamId])
}

model FeatureFlag {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key          String
  enabled      Boolean  @default(true)
  configJson   Json?

  @@unique([workspaceId, key])
}

model WorkspacePreference {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  preferencesJson Json?

  @@unique([workspaceId, userId])
}

model AuditEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorUser       User?    @relation(fields: [actorUserId], references: [id])
  action          String
  entityType      String
  entityId        String?
  beforeJson      Json?
  afterJson       Json?
  ipHash          String?
  userAgentSummary String?
  occurredAt      DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([entityType, entityId])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Company {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name           String
  domain         String?
  website        String?
  industry       String?
  sizeBand       String?
  phone          String?
  ownerId        String?
  owner          User?    @relation(fields: [ownerId], references: [id])
  lifecycleStage String   @default("lead") // lead | engaged | customer | churned
  addressJson    Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  archivedAt     DateTime?

  contacts       Contact[]
  leads          Lead[]
  deals          Deal[]
  client         Client?

  @@index([workspaceId, name])
  @@index([workspaceId, ownerId])
}

model Contact {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id])
  firstName       String?
  lastName        String?
  email           String?
  phone           String?
  jobTitle        String?
  ownerId         String?
  owner           User?    @relation(fields: [ownerId], references: [id])
  lifecycleStage  String   @default("lead")
  marketingConsent Boolean @default(false)
  portalIdentityId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  archivedAt      DateTime?

  leads           Lead[]
  deals           Deal[]
  clientContacts  ClientContact[]
  activities      Activity[]
  portals         ClientPortal[]

  @@index([workspaceId, email])
  @@index([workspaceId, ownerId])
}

model Lead {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  contactId         String?
  contact           Contact? @relation(fields: [contactId], references: [id])
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])
  source            String?
  score             Int      @default(0)
  status            String   @default("new") // new | qualified | disqualified | converted
  ownerId           String?
  owner             User?    @relation(fields: [ownerId], references: [id])
  qualifiedAt       DateTime?
  disqualifiedReason String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
}

model Pipeline {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  entityType   String   @default("deal")
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  stages       PipelineStage[]
  deals        Deal[]

  @@unique([workspaceId, name])
}

model PipelineStage {
  id           String   @id @default(cuid())
  pipelineId   String
  pipeline     Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  probability  Int      @default(0) // 0-100
  color        String?
  isClosed     Boolean  @default(false)
  isWon        Boolean  @default(false)

  deals        Deal[]

  @@unique([pipelineId, name])
}

model Deal {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company? @relation(fields: [companyId], references: [id])
  primaryContactId  String?
  primaryContact    Contact? @relation(fields: [primaryContactId], references: [id])
  pipelineId        String?
  pipeline          Pipeline? @relation(fields: [pipelineId], references: [id])
  stageId           String?
  stage             PipelineStage? @relation(fields: [stageId], references: [id])
  name              String
  amountMinor       BigInt   @default(0)
  currency          String   @default("USD")
  probability       Int      @default(0)
  expectedCloseDate DateTime?
  ownerId           String?
  owner             User?    @relation(fields: [ownerId], references: [id])
  wonAt             DateTime?
  lostAt            DateTime?
  lostReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  activities        Activity[]

  @@index([workspaceId, ownerId])
  @@index([workspaceId, stageId])
}

model Activity {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  activityType String   // call | email | meeting | task | note
  subject      String?
  body         String?
  dueAt        DateTime?
  completedAt  DateTime?
  ownerId      String?
  owner        User?    @relation(fields: [ownerId], references: [id])
  contactId    String?
  contact      Contact? @relation(fields: [contactId], references: [id])
  dealId       String?
  deal         Deal?    @relation(fields: [dealId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, entityType, entityId])
  @@index([workspaceId, ownerId])
}

model Tag {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  color        String?

  @@unique([workspaceId, name])
}

model Note {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String
  bodyRich     String
  visibility   String   @default("internal") // internal | client | restricted
  authorId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, entityType, entityId])
}

// ---------------------------------------------------------------------------
// Client & commercial
// ---------------------------------------------------------------------------

model Client {
  id               String   @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  companyId        String?  @unique
  company          Company? @relation(fields: [companyId], references: [id])
  name             String
  code             String?
  status           String   @default("active") // prospect | active | at_risk | churned
  healthScore      Int      @default(70) // 0-100
  healthReason     String?
  ownerId          String?
  owner            User?    @relation(fields: [ownerId], references: [id])
  portalSlug       String?  @unique
  portalEnabled    Boolean  @default(false)
  onboardingStatus String   @default("pending") // pending | in_progress | complete
  startDate        DateTime?
  renewalDate      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  clientContacts   ClientContact[]
  retainers        Retainer[]
  contracts        Contract[]
  clientRequests   ClientRequest[]
  clientHealthEvents ClientHealthEvent[]
  projects         Project[]
  campaigns        Campaign[]
  deliverables     Deliverable[]
  expenses         Expense[]
  estimates        Estimate[]
  invoices         Invoice[]
  portals          ClientPortal[]
  timeEntries      TimeEntry[]

  @@index([workspaceId, status])
  @@index([workspaceId, ownerId])
}

model ClientContact {
  id              String   @id @default(cuid())
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  contactId       String
  contact         Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  relationshipRole String?
  isPrimary       Boolean  @default(false)
  portalAccess    Boolean  @default(false)

  @@unique([clientId, contactId])
}

model Service {
  id                 String   @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  description        String?
  defaultRateMinor   BigInt   @default(0)
  billingUnit        String   @default("hour")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  rateCards          RateCard[]

  @@unique([workspaceId, name])
}

model Retainer {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String
  startDate         DateTime
  endDate           DateTime?
  amountMinor       BigInt   @default(0)
  currency          String   @default("USD")
  includedMinutes   Int      @default(0)
  rolloverPolicy    String   @default("none")
  status            String   @default("active")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientId])
}

model Contract {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  status       String   @default("draft")
  startsOn     DateTime?
  endsOn       DateTime?
  valueMinor   BigInt   @default(0)
  currency     String   @default("USD")
  fileId       String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt


  @@index([clientId])
}

model ClientRequest {
  id                String   @id @default(cuid())
  workspaceId       String
  workspace         Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  priority          String   @default("normal") // low | normal | high | urgent
  status            String   @default("new") // new | in_progress | blocked | done | cancelled
  requesterContactId String?
  assignedUserId    String?
  dueAt             DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientId, status])
}

model ClientHealthEvent {
  id           String   @id @default(cuid())
  clientId     String
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  score        Int
  reason       String?
  source       String?
  occurredAt   DateTime @default(now())

  @@index([clientId, occurredAt])
}

// ---------------------------------------------------------------------------
// Delivery
// ---------------------------------------------------------------------------

model ProjectTemplate {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  templateJson Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, name])
}

model Project {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  name          String
  code          String?
  description   String?
  statusId      String?
  status        ProjectStatus? @relation(fields: [statusId], references: [id])
  ownerId       String?
  owner         User?    @relation(fields: [ownerId], references: [id])
  startDate     DateTime?
  dueDate       DateTime?
  budgetMinor   BigInt   @default(0)
  currency      String   @default("USD")
  budgetMinutes Int      @default(0)
  visibility    String   @default("internal") // internal | client | restricted
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  deliverables  Deliverable[]
  tasks         Task[]
  campaigns     Campaign[]
  timeEntries   TimeEntry[]
  expenses      Expense[]
  milestones    Milestone[]
  members       ProjectMember[]

  @@index([workspaceId, clientId])
  @@index([workspaceId, ownerId])
}

model ProjectStatus {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  color        String?
  category     String   @default("active") // planning | active | on_hold | done | cancelled

  projects     Project[]

  @@unique([workspaceId, name])
}

model ProjectMember {
  id           String   @id @default(cuid())
  projectId     String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  membershipId String
  membership   WorkspaceMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  accessLevel  String   @default("viewer") // viewer | editor | manager

  @@unique([projectId, membershipId])
}

model Milestone {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  dueDate      DateTime?
  status       String   @default("planned")

  tasks        Task[]
}

model TaskStatus {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  position     Int
  color        String?
  category     String   @default("todo") // todo | in_progress | done | blocked

  tasks        Task[]

  @@unique([workspaceId, name])
}

model Task {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId       String?
  project         Project? @relation(fields: [projectId], references: [id])
  parentTaskId    String?
  milestoneId     String?
  milestone       Milestone? @relation(fields: [milestoneId], references: [id])
  name            String
  descriptionRich String?
  statusId        String?
  status          TaskStatus? @relation(fields: [statusId], references: [id])
  priority        String   @default("normal") // low | normal | high | urgent
  ownerId         String?
  owner           User?    @relation("TaskOwner", fields: [ownerId], references: [id])
  assigneeId      String?
  assignee        User?    @relation("TaskAssignee", fields: [assigneeId], references: [id])
  startAt         DateTime?
  dueAt           DateTime?
  estimateMinutes Int      @default(0)
  billable        Boolean  @default(true)
  position        Int      @default(0)
  visibility      String   @default("internal")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  dependencies    TaskDependency[] @relation("TaskDependsOn")
  dependents      TaskDependency[] @relation("TaskDependent")
  watchers        TaskWatcher[]
  timeEntries     TimeEntry[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, statusId])
}

model TaskDependency {
  taskId          String
  task            Task @relation("TaskDependent", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task @relation("TaskDependsOn", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)

  @@id([taskId, dependsOnTaskId])
}

model TaskWatcher {
  taskId    String
  task      Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String

  @@id([taskId, userId])
}

model Campaign {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  name         String
  channel      String?
  objective    String?
  status       String   @default("planned")
  startDate    DateTime?
  endDate      DateTime?
  budgetMinor  BigInt   @default(0)
  currency     String   @default("USD")
  ownerId      String?
  owner        User?    @relation("CampaignOwner", fields: [ownerId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliverables Deliverable[]
  contentItems ContentItem[]

  @@index([workspaceId, clientId])
}

model Deliverable {
  id               String   @id @default(cuid())
  workspaceId      String
  workspace        Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id])
  campaignId       String?
  campaign         Campaign? @relation(fields: [campaignId], references: [id])
  taskId           String?
  clientId         String?
  client           Client?  @relation(fields: [clientId], references: [id])
  name             String
  type             String?
  status           String   @default("draft")
  dueAt            DateTime?
  ownerId          String?
  owner            User?    @relation("DeliverableOwner", fields: [ownerId], references: [id])
  currentVersionId String?
  visibility       String   @default("internal")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  versions         DeliverableVersion[]

  @@index([workspaceId, projectId])
  @@index([workspaceId, clientId])
}

model ContentItem {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  campaignId   String?
  campaign     Campaign? @relation(fields: [campaignId], references: [id])
  deliverableId String?
  channel      String?
  title        String
  bodyRich     String?
  publishAt    DateTime?
  status       String   @default("draft")
  ownerId      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, campaignId])
}

// ---------------------------------------------------------------------------
// Collaboration, files, approvals
// ---------------------------------------------------------------------------

model Comment {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  parentCommentId String?
  bodyRich        String
  visibility      String   @default("internal")
  authorId        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  editedAt        DateTime?

  mentions        CommentMention[]

  @@index([workspaceId, entityType, entityId])
}

model CommentMention {
  id              String   @id @default(cuid())
  commentId       String
  comment         Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String

  @@index([commentId])
}

model ActivityEvent {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorUser       User?    @relation(fields: [actorUserId], references: [id])
  verb            String
  entityType      String
  entityId        String
  metadataJson    Json?
  visibility      String   @default("internal")
  occurredAt      DateTime @default(now())

  @@index([workspaceId, occurredAt])
  @@index([workspaceId, entityType, entityId])
}

model Notification {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String
  title        String
  body         String?
  entityType   String?
  entityId     String?
  readAt       DateTime?
  emailedAt    DateTime?
  createdAt    DateTime @default(now())

  @@index([userId, readAt])
}

model FileRecord {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  bucket          String   @default("workspace-assets")
  objectPath      String
  originalName    String
  contentType     String?
  sizeBytes       BigInt   @default(0)
  checksum        String?
  uploaderId      String?
  visibility      String   @default("internal")
  scanStatus      String   @default("pending")
  createdAt       DateTime @default(now())

  fileLinks       FileLink[]

  @@index([workspaceId])
}

model FileLink {
  id           String   @id @default(cuid())
  fileId       String
  file         FileRecord @relation(fields: [fileId], references: [id], onDelete: Cascade)
  entityType   String
  entityId     String

  @@index([fileId])
  @@index([entityType, entityId])
}

model DeliverableVersion {
  id            String   @id @default(cuid())
  deliverableId String
  deliverable   Deliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  versionNumber Int
  fileId        String?
  notes         String?
  createdById   String?
  createdAt     DateTime @default(now())

  @@unique([deliverableId, versionNumber])
}

model ApprovalRequest {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  versionNumber   Int      @default(1)
  title           String
  instructions    String?
  status          String   @default("pending") // pending | approved | changes_requested | cancelled
  dueAt           DateTime?
  requestedById   String?
  requestedBy     User?    @relation(fields: [requestedById], references: [id])
  decidedAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  steps           ApprovalStep[]
  events          ApprovalEvent[]

  @@index([workspaceId, status])
}

model ApprovalEvent {
  id              String   @id @default(cuid())
  approvalRequestId String
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  actorUserId     String?
  actorUser       User?    @relation("ApprovalEventActor", fields: [actorUserId], references: [id])
  action          String   // requested | approved | changes_requested | cancelled | reopened
  note            String?
  occurredAt      DateTime @default(now())

  @@index([approvalRequestId, occurredAt])
}

model ApprovalStep {
  id              String   @id @default(cuid())
  approvalRequestId String
  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  position        Int
  approverType    String   // user | contact | client_contact
  approverId      String?
  status          String   @default("pending") // pending | approved | changes_requested | skipped
  decidedAt       DateTime?
  decisionNote    String?
  decidedByUserId String?
  user            User?    @relation(fields: [decidedByUserId], references: [id])

  @@index([approvalRequestId])
}

// ---------------------------------------------------------------------------
// Time, capacity, finance
// ---------------------------------------------------------------------------

model TimeEntry {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  taskId       String?
  task         Task?    @relation(fields: [taskId], references: [id])
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  startedAt    DateTime
  endedAt      DateTime?
  minutes      Int      @default(0)
  description  String?
  billable     Boolean  @default(true)
  rateMinor    BigInt   @default(0)
  currency     String   @default("USD")
  status       String   @default("open") // open | submitted | approved | rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, userId, startedAt])
  @@index([workspaceId, projectId])
}

model Timesheet {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  periodStart  DateTime
  periodEnd    DateTime
  status       String   @default("open") // open | submitted | approved | rejected
  submittedAt  DateTime?
  approvedAt   DateTime?
  approvedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([workspaceId, userId, periodStart])
}

model CapacityAllocation {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  projectId       String?
  startsOn        DateTime
  endsOn          DateTime
  allocatedMinutes Int     @default(0)

  @@index([workspaceId, userId, startsOn])
}

model RateCard {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String?
  serviceId    String?
  service      Service? @relation(fields: [serviceId], references: [id])
  roleId       String?
  rateMinor    BigInt   @default(0)
  currency     String   @default("USD")
  startsOn     DateTime @default(now())

  @@index([workspaceId, clientId])
}

model Expense {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId     String?
  client       Client?  @relation(fields: [clientId], references: [id])
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id])
  category     String
  amountMinor  BigInt   @default(0)
  currency     String   @default("USD")
  incurredOn   DateTime @default(now())
  billable     Boolean  @default(false)
  receiptFileId String?
  status       String   @default("draft") // draft | submitted | approved | invoiced
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([workspaceId, clientId])
}

model Estimate {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  status        String   @default("draft")
  currency      String   @default("USD")
  subtotalMinor BigInt   @default(0)
  taxMinor      BigInt   @default(0)
  totalMinor    BigInt   @default(0)
  validUntil    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines         EstimateLine[]
}

model EstimateLine {
  id              String   @id @default(cuid())
  estimateId      String
  estimate        Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  description     String
  quantityDecimal Float    @default(1)
  unitPriceMinor  BigInt   @default(0)
  taxRateDecimal  Float    @default(0)
}

model Invoice {
  id            String   @id @default(cuid())
  workspaceId   String
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId      String?
  client        Client?  @relation(fields: [clientId], references: [id])
  number        String
  status        String   @default("draft") // draft | sent | paid | overdue | cancelled
  currency      String   @default("USD")
  issuedOn      DateTime @default(now())
  dueOn         DateTime?
  subtotalMinor BigInt   @default(0)
  taxMinor      BigInt   @default(0)
  totalMinor    BigInt   @default(0)
  paidMinor     BigInt   @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  lines         InvoiceLine[]
  payments      Payment[]

  @@unique([workspaceId, number])
}

model InvoiceLine {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description     String
  quantityDecimal Float    @default(1)
  unitPriceMinor  BigInt   @default(0)
  taxRateDecimal  Float    @default(0)
  projectId       String?
  timeEntryId     String?
}

model Payment {
  id              String   @id @default(cuid())
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  providerReference String?
  amountMinor     BigInt   @default(0)
  currency        String   @default("USD")
  paidAt          DateTime @default(now())
  status          String   @default("completed")
}

// ---------------------------------------------------------------------------
// Customization, reporting, automation
// ---------------------------------------------------------------------------

model CustomFieldDefinition {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType      String
  key             String
  label           String
  dataType        String   // text | number | currency | percentage | boolean | date | datetime | select | multiselect | email | url | phone | user | company | contact | client
  required        Boolean  @default(false)
  optionsJson     Json?
  validationJson  Json?
  position        Int      @default(0)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  values          CustomFieldValue[]

  @@unique([workspaceId, entityType, key])
}

model CustomFieldValue {
  id              String   @id @default(cuid())
  definitionId    String
  definition      CustomFieldDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType      String
  entityId        String
  valueJson       Json?

  @@unique([definitionId, entityId])
  @@index([workspaceId, entityType, entityId])
}

model SavedView {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entityType   String
  name         String
  ownerId      String?
  visibility   String   @default("private") // private | workspace
  queryJson    Json?
  columnsJson  Json?
  sortJson     Json?

  @@unique([workspaceId, entityType, name])
}

model Dashboard {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name         String
  ownerId      String?
  visibility   String   @default("workspace")
  layoutJson   Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  widgets      DashboardWidget[]
}

model DashboardWidget {
  id           String   @id @default(cuid())
  dashboardId  String
  dashboard    Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  widgetType   String
  queryJson    Json?
  displayJson  Json?
  positionJson Json?
}

model ReportDefinition {
  id              String   @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  subjectType     String
  dimensionsJson  Json?
  measuresJson    Json?
  filtersJson     Json?
  visualizationJson Json?
  visibility      String   @default("workspace")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Automation {
  id                 String   @id @default(cuid())
  workspaceId        String
  workspace          Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name               String
  triggerType        String
  triggerConfigJson  Json?
  conditionTreeJson  Json?
  enabled            Boolean  @default(true)
  version            Int      @default(1)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  actions            AutomationAction[]
  runs               AutomationRun[]
}

model AutomationAction {
  id           String   @id @default(cuid())
  automationId String
  automation   Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  position     Int
  actionType   String
  configJson   Json?

  actionRuns   AutomationActionRun[]
}

model AutomationRun {
  id              String   @id @default(cuid())
  automationId    String
  automation      Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggerEventId  String?
  status          String   @default("pending") // pending | running | succeeded | failed | dead_letter
  idempotencyKey  String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  errorSummary    String?

  actionRuns      AutomationActionRun[]
}

model AutomationActionRun {
  id              String   @id @default(cuid())
  runId           String
  run             AutomationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  actionId        String
  action          AutomationAction @relation(fields: [actionId], references: [id], onDelete: Cascade)
  status          String   @default("pending")
  attempts        Int      @default(0)
  outputJson      Json?
  errorSummary    String?
}

model WebhookEndpoint {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url          String
  secretCiphertext String?
  eventTypesJson Json?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  deliveries   WebhookDelivery[]
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  endpointId   String
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  eventId      String
  status       String   @default("pending")
  attempts     Int      @default(0)
  nextAttemptAt DateTime?
  responseCode Int?
}

model OutboxEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  eventType    String
  entityType   String
  entityId     String?
  actorUserId  String?
  payload      Json
  createdAt    DateTime @default(now())
  processedAt  DateTime?
  attempts     Int      @default(0)
  nextAttemptAt DateTime @default(now())

  @@index([processedAt, nextAttemptAt])
}

model IntegrationConnection {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider     String
  status       String   @default("disconnected")
  scopesJson   Json?
  credentialReference String?
  connectedById String?
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ImportJob {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         String
  fileId       String?
  mappingJson  Json?
  status       String   @default("pending") // pending | validating | running | completed | failed
  totalsJson   Json?
  errorFileId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ExportJob {
  id           String   @id @default(cuid())
  workspaceId  String
  workspace    Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  type         String
  queryJson    Json?
  status       String   @default("pending")
  objectPath   String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

