# AgencyOS environment contract
# Copy to `.env.local` (git-ignored) and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase — required by both apps
# ---------------------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable ("anon") key. Safe to expose to the browser; RLS is the guard.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service-role key. SERVER ONLY. Bypasses RLS. Never expose to the browser and
# never add a NEXT_PUBLIC_ prefix to it. Only the outbox worker reads this.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Split deployment
# ---------------------------------------------------------------------------
# Origin of the authenticated app, used by apps/web to link across domains.
# Production: https://app.example.com. Local dev defaults to http://localhost:3001.
NEXT_PUBLIC_APP_URL=

# ---------------------------------------------------------------------------
# Background work
# ---------------------------------------------------------------------------
# Bearer token required by POST /api/cron/process-outbox. The route fails
# closed with 503 when this is unset, so the outbox will not drain without it.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------
# Default HMAC secret used to sign outbound webhook deliveries when an
# individual webhook endpoint does not carry its own secret.
# (Read at apps/app/src/lib/automation.ts.)
WEBHOOK_SIGNING_SECRET=

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
# Invitations and password reset cannot complete end-to-end without a provider.
EMAIL_PROVIDER=
EMAIL_FROM=
EMAIL_API_KEY=

# ---------------------------------------------------------------------------
# Development-only escape hatches — NEVER set these in staging or production
# ---------------------------------------------------------------------------
# Allows the demo-data seeder to run when NODE_ENV=production. Seeding writes a
# fictional agency into a real workspace. Leave unset.
# AGENCYOS_ALLOW_DEMO_SEED=

# Disables the HTTPS requirement and the private-IP guard on outbound webhooks.
# Only honoured when NODE_ENV is not production, but do not set it regardless.
# ALLOW_INSECURE_WEBHOOKS=
